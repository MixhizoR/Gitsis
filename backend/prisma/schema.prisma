// ============================================================================
//  schema.prisma  —  EHSIM - GITSIS / RMT veri tabani semasi (PostgreSQL).
//  Tum veri PROJE bazli izole edilir (project-isolated). Bir proje silinince
//  ona ait tum kayitlar cascade ile temizlenir.
//  Tablolar: Users, SystemRoles, Projects, ProjectFields, Requirements,
//            TestCases, TraceabilityLinks, GlossaryTerms, AuditLogs,
//            RefreshTokens, SystemAuditLogs.
//  Issue #97: Personnel (passcode) ve proje-bazli Role modelleri KALDIRILDI.
//  Tek kimlik dunyasi: User (sifre ile) -> SystemRole (roleKey, izinler).
//  Onay oylari tamamen User tabanlidir (voterId = User UUID).
//  Issue #85: User password -> passwordHash; sistem geneli auth olaylari
//            SystemAuditLog'a, refresh token ozetleri RefreshToken'a yazilir.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  // Debian slim (ARM64) icin dogru sorgu motoru ikili dosyasi uretilsin.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Kullanicilar (kimlik dogrulama) ---------------------------------------
//  Issue #85: Auth epik altyapisi — password -> passwordHash, clearanceLevel
//  (ABAC, #87'de tuketilir), isActive / failedAttempts / lockedUntil kolonlari
//  (kilitleme mantigi #86'da).
//  `role` KORUNUR: display adi + eski veri fallback'i (PM_ROLE).
//  Issue #101: Admin bir ROL'dur — ayri `systemRole` kolonu KALDIRILDI;
//  konsol erisimi yalnizca `roleKey === 'admin'` ile belirlenir.
model User {
  id             String    @id @default(uuid())
  username       String    @unique
  passwordHash   String
  name           String
  initials       String?
  role           String    @default("System Engineer")
  // Issue #101: sistem-geneli sabit role anahtari (SystemRole.key). `role`
  // display adi olarak korunur; yetki bu anahtardan turetilir. Eski verilerde
  // null olabilir (o zaman `role` eslesmesi - PM_ROLE - gecerli kalir).
  roleKey        String?
  clearanceLevel Int       @default(1)
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  // Issue #103: proje uyeligi User.projectId yerine coktan-coga ProjectMember
  // uzerinden modellenir. PM'ler uyelik kaydi OLMADAN tum projelere erisir.
  memberships    ProjectMember[]

  // --- Sorumlu kullanici (is atama) ---------------------------------------
  //  #114/#115'in coklu atama ozelligi Personel yerine USER tabanlidir
  //  (#97 Personel'i kaldirdi). Atanabilmek icin kullanicinin projede
  //  ProjectMember uyeligi olmalidir (bkz. src/assignees.js).
  assignedRequirements   Requirement[]            @relation("RequirementAssignee")
  assignedTestCases      TestCase[]               @relation("TestCaseAssignee")
  requirementAssignments RequirementAssignee[]
  testCaseAssignments    TestCaseAssignee[]

  refreshTokens  RefreshToken[]
}

// --- Proje uyeligi (Issue #103, coktan-coga) --------------------------------
//  PM (roleKey='pm') uyelik kaydi TUTMAZ — erisimi isPM yoluyla saglanir.
//  Normal kullanici yalnizca buradaki kayitlarla projelere girer; uyeligi
//  olmayan kullanici hicbir projeyi goremez (liste + guard 403). Yetki
//  kaynagi User.roleKey -> SystemRole kalir (proje-bazli override YOK).
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// --- Sistem-geneli sabit roller (Issue #101) --------------------------------
//  Personel/passcode dunyasindaki proje-bazli `Role` modelinden AYRI: bu,
//  User.role icin SISTEM seviyesinde tanimli cekirdek roller + izinleridir
//  (PM / System Engineer / Developer / Admin...). `permissions` 12 kademeli
//  izin JSON'udur (frontend utils/permissions.js semasi). isSystem=true olan
//  roller silinemez (yalnizca pasiflestirilebilir) — DO-178C tasarim karari.
//  Ileride ozel (custom) rol eklemek icin zemin: isSystem=false + admin CRUD.
model SystemRole {
  id          String    @id @default(uuid())
  key         String    @unique // 'pm' | 'system_engineer' | 'developer' | ...
  name        String
  permissions Json      @default("{}")
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

// --- Refresh tokenlari (Issue #85) -----------------------------------------
//  #86'da kullanilacak: ham token ASLA saklanmaz, yalnizca SHA-256 ozeti
//  (tokenHash) tutulur. Kullanici silinince tokenlari da cascade ile silinir.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Sistem geneli denetim kayitlari (Issue #85) ---------------------------
//  Proje-ceperli AuditLog'dan AYRI: auth/system olaylari (login, lock,
//  admin islemleri) global olarak buraya yazilir. userId null olabilir
//  (ornegin basarisiz login — kimlik dogrulanamamis).
model SystemAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// --- Projeler ---------------------------------------------------------------
model Project {
  id           String             @id @default(uuid())
  name         String
  description  String             @default("")
  // text_id onegi: <codePrefix>-<TIP>-<NNN> (orn. EH-KAHVE-TID-USR-001).
  // Proje bazlidir; bos birakilirsa DEFAULT_CODE_PREFIX kullanilir.
  codePrefix   String             @default("EH-KAHVE-TİD")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  fields       ProjectField[]
  attributeDefs AttributeDefinition[]
  requirements Requirement[]
  testCases    TestCase[]
  links        TraceabilityLink[]
  glossary     GlossaryTerm[]
  audit        AuditLog[]
  members      ProjectMember[]
  approvals    Approval[]
  snapshots    ProjectSnapshot[]
  navGroups    NavGroup[]
  navItems     NavItem[]
  history      RequirementHistory[]
  documents    ProjectDocument[]
  comments     Comment[]
}

// --- Proje SILME gerekcesi (izlenebilirlik) ---------------------------------
//  Proje silinince o projeye ait AuditLog kayitlari da CASCADE ile silinir
//  (Project.audit FK, onDelete: Cascade) — yani "neden silindi" gerekcesini
//  normal AuditLog'a yazmak anlamsizdir, o kayit projeyle BIRLIKTE yok olur.
//  Bu tablo projeye FK ILE BAGLI DEGILDIR (duz string id + ad kopyasi) —
//  proje silindikten SONRA da izlenebilir kalir. Yalnizca PM gorebilir
//  (GET /api/project-deletions).
model ProjectDeletionLog {
  id          String   @id @default(uuid())
  projectId   String
  projectName String
  reason      String
  actor       String?
  deletedAt   DateTime @default(now())
}

// --- Snaphotlar (baseline / sürüm) ----------------------------------------
//  Belirli bir andaki proje verisinin donmus kopyası. SnapshotItem,
//  o andaki tüm Requirement/TestCase/GlossaryTerm + Link kayıtlarını
//  JSON blob olarak saklar (salt okunur, gelecek restore/diff için).
model ProjectSnapshot {
  id        String   @id @default(uuid())
  projectId String
  name      String
  createdBy String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items     SnapshotItem[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([projectId, createdAt])
}

model SnapshotItem {
  id           String   @id @default(uuid())
  snapshotId   String
  entityType   String // 'requirement' | 'testcase' | 'glossary' | 'link'
  entityId     String
  data         Json   // o anki kaydın tam kopyası (field-by-field)
  createdAt    DateTime @default(now())
  snapshot     ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([snapshotId, entityType])
}

// --- Yorumlar (ana varliklar uzerinde ekip ici iletisim) --------------------
//  ONAY/REVIEW SURECINDEN BAGIMSIZDIR: yorum eklemek bir kaydin durumunu,
//  onayini veya kilidini ETKILEMEZ; yalnizca ekip ici not/soru alanidir.
//
//  GENERIC: tek tablo tum ana varliklara hizmet eder (entityType + entityId).
//  Bu yuzden entityId'ye foreign key KONULMAZ — hedef tablo satira gore
//  degisir. Varligin gercekten ayni projede oldugu YAZMA aninda dogrulanir
//  (bkz. src/comments.js assertEntityInProject).
//
//  authorName / authorRole ANLIK KOPYADIR: kullanici silinse ya da rolu
//  degisse bile yorumun yazildigi andaki kimlik korunur (izlenebilirlik).
model Comment {
  id         String   @id @default(uuid())
  projectId  String
  entityType String // 'requirement' | 'testcase' | 'glossary'
  entityId   String
  // Issue #97: tek kimlik dunyasi — yazan her zaman User.id'dir.
  authorId   String
  authorName String
  authorRole String?
  text       String
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Bir varligin yorumlari kronolojik cekilir; sorgu deseni birebir bu index.
  @@index([projectId, entityType, entityId, createdAt])
  @@index([projectId])
}

// --- Proje Dokumanlari (Dokuman Kutuphanesi) -------------------------------
//  Kullanicinin bilgisayarindan yukledigi PDF / Excel belgeleri. Dosya icerigi
//  (bytea) veritabaninda saklanir; boylece backend konteyneri yeniden
//  olusturulsa bile kutuphane kalici kalir (DB Docker volume uzerindedir).
//  Listeleme sorgulari `content` alanini ASLA secmez (bkz. src/documents.js).
model ProjectDocument {
  id                  String        @id @default(uuid())
  projectId           String
  fileName            String
  ext                 String // '.pdf' | '.xlsx' | '.xls'
  mimeType            String
  size                Int // bayt
  description         String        @default("")
  uploadedBy          String?
  content             Bytes
  // Issue: dokumandan metin secerek gereksinim olusturma. Yukleme aninda
  // cikarilan duz metin; kullanici bunun uzerinde secim yapar ve secimin
  // karakter araligi gereksinime kaynak olarak yazilir. Bu yuzden metnin
  // KARARLI olmasi sart: bir kez cikarilir, bir daha degismez (aksi halde
  // eski gereksinimlerin sourceStart/End araliklari kayar).
  extractedText       String?
  // 'pending' | 'ready' | 'unsupported' (orn. eski .xls) | 'failed'
  textStatus          String        @default("pending")
  createdAt           DateTime      @default(now())
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Bu dokumandan turetilmis gereksinimler. Dokuman silinirse gereksinim
  // SILINMEZ (SetNull) — bkz. Requirement.sourceDocument.
  sourcedRequirements Requirement[] @relation("RequirementSource")

  @@index([projectId])
  @@index([projectId, createdAt])
}

// --- Onay oylari (consensus, Issue #97: tamamen User tabanli) ---------------
//  Bir gereksinim/test icin bir kullanicinin onayi. voterId artik HER ZAMAN
//  User UUID'sidir (eski 'PM' sentinel'i ve personnelId kaldirildi). Gerekli
//  oy verenler = PM'ler + projeye atanmis, o bilesende approve izni olan
//  uyeler (bkz. backend/src/cascade.js getRequiredVoters).
model Approval {
  id          String   @id @default(uuid())
  projectId   String
  entityType  String
  entityId    String
  voterId     String
  voterName   String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, entityType, entityId, voterId])
  @@index([projectId, entityType, entityId])
}

// --- Dinamik "Alan" (Field / Disiplin) secenekleri (proje bazli) -----------
model ProjectField {
  id        String  @id @default(uuid())
  projectId String
  name      String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

// --- Sol menu duzeni: gruplar + sayfa yerlesimi (proje bazli) --------------
//  ONEMLI: Kullanici yalnizca GRUPLAMA yapar; gereksinim/test TIPLERI ve
//  sayfa anahtarlari (pageKey) SABITTIR (bkz. navDefaults.js). Boylece
//  DO-178C hiyerarsi kurallari ve 12 kademeli izin matrisi etkilenmez.
model NavGroup {
  id        String   @id @default(uuid())
  projectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items     NavItem[]

  @@unique([projectId, name])
  @@index([projectId])
}

model NavItem {
  id        String    @id @default(uuid())
  projectId String
  // null => grupsuz (en ust seviyede gorunur). Grup silinince item'lar
  // SetNull ile grupsuz seviyeye duser; hicbir sayfa kaybolmaz.
  groupId   String?
  // Temel sayfa tipi (SABIT liste — navDefaults.js NAV_PAGE_KEYS).
  // Ayni pageKey birden fazla menu ogesinde kullanilabilir: kullanici bir
  // gruba ayni tipten birden cok "ozel sayfa" ekleyebilir (farkli ad/filtre).
  pageKey   String
  // Ozel sayfa etiketi. null => varsayilan i18n etiketi kullanilir.
  label     String?
  // Ozel sayfanin Alan (disiplin) filtresi. null => filtre yok, tam liste.
  // Tipler sabit kaldigi icin ayrisma bu filtre uzerinden saglanir.
  fieldFilter String?
  // Ozel sayfanin gereksinim TIPI filtresi (yalnizca birden fazla tipi
  // birlikte gosteren pageKey'lerde anlamlidir, orn. req-subsystem'in
  // Software/Hardware Requirement'i birlikte gosterdigi durum). null =>
  // filtre yok, o pageKey'in tum tipleri birlikte gosterilir. Gecerli
  // degerler navDefaults.js PAGE_TYPE_OPTIONS ile sinirlidir.
  typeFilter  String?
  order     Int       @default(0)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group     NavGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// --- Gereksinimler (User / System / Software / Hardware) --------------------
model Requirement {
  id          String   @id @default(uuid())
  projectId   String
  // PBS (Urun Agaci) hiyerarsisi — adjacency list (Issue #9).
  // TraceabilityLink 'Satisfies' cok-ebeveynli izlenebilirlik semantigini
  // korur; parentId ise agac gezinme icin TEK ebeveynli yapiyi tutar.
  parentId    String?
  text_id     String
  title       String
  description String   @default("")
  type        String   // 'User Requirement' | 'System Requirement' | 'Software Requirement' | 'Hardware Requirement'
  field       String? // dinamik Alan / disiplin
  status      String   @default("In Review")
  // Modular oznitelikler (Priority, DAL Level, ve projeye ozel her turlu ek
  // alan) artik sabit kolon degil; AttributeDefinition tarafindan tanimlanan
  // semaya gore bu JSONB torbada saklanir. Bkz. src/attributes.js.
  attributes  Json     @default("{}")
  author      String?
  approvalStatus String @default("Pending") // 'Pending' | 'Approved'
  locked         Boolean @default(false)    // onaylandiginda kilitlenir
  clearanceLevel Int    @default(1)         // Issue #85: ABAC (#87) icin — varsayilan 1
  relatedDocuments String[] @default([])    // Etki analizinde gosterilen ilgili dokuman/etiket listesi
  // --- Kaynak izlenebilirligi (dokumandan metin secerek olusturma) --------
  //  Gereksinim bir dokuman pasajindan turetildiyse burada baglanir.
  //  ONEMLI: Dokuman silinince gereksinim SILINMEZ; yalnizca bag bosa duser
  //  (onDelete: SetNull). Alinti ve dokuman adi ANLIK KOPYA olarak saklanir
  //  ki bag koptuktan sonra da UI "kaynak dokuman silinmis: <ad>" diyebilsin.
  sourceDocumentId   String?
  sourceStart        Int?    // extractedText icindeki karakter araligi [start, end)
  sourceEnd          Int?
  sourceQuote        String? // secilen pasajin kopyasi (dokuman silinse de kalir)
  sourceDocumentName String? // dokuman adinin anlik kopyasi
  // --- Sorumlu kullanici (is atama) ---------------------------------------
  //  #97/A karari: atama USER tabanlidir (eski Personnel degil); atanabilmek
  //  icin kullanicinin projede ProjectMember uyeligi olmalidir. Kullanici
  //  silinince gereksinim SILINMEZ, atama bosa duser (SetNull).
  assigneeId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDocument ProjectDocument? @relation("RequirementSource", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  parent      Requirement?  @relation("RequirementTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Requirement[] @relation("RequirementTree")
  history     RequirementHistory[]
  assignee    User?     @relation("RequirementAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // Coklu atama: bir gereksinim birden fazla kisiye verilebilir. assigneeId
  // bu listenin ILK elemaninin kopyasidir (bkz. src/assignees.js).
  assignees   RequirementAssignee[]

  @@unique([projectId, text_id])
  @@index([projectId, type])
  @@index([projectId, parentId])
  @@index([sourceDocumentId])
  @@index([projectId, assigneeId])
}

// --- Gereksinim versiyon gecmisi (SCD Type 4) ------------------------------
//  Issue #57: Her ICERIK degisiminde (title/description/field + attributes
//  icindeki priority/dal_level) ESKI durumun tam kopyasi bu tabloya yazilir.
//  Ana tablo guncel durumu tasir; bu tablo gecmis versiyonlari saklar.
//  version sayaci gereksinim bazli 1'den baslar; her satir, degisikligi
//  yapan UPDATE kaydina (AuditLog) auditLogId ile baglanir (kim neyi
//  degistirdi tek yerden izlenir). Otomatik status/approval cascade'leri bu
//  tabloya YAZMAZ (yalnizca PUT ile yapilan icerik degisimleri tetikler).
model RequirementHistory {
  id               String   @id @default(uuid())
  projectId        String
  requirementId    String
  version          Int      // gereksinim bazli, 1'den baslar
  // Ana tablo alan kopyasi (degisiklik ONCESI durum)
  text_id          String
  title            String
  description      String   @default("")
  type             String
  field            String?
  status           String
  approvalStatus   String   @default("Pending")
  locked           Boolean  @default(false)
  attributes       Json     @default("{}")
  author           String?
  relatedDocuments String[] @default([])
  changedAt        DateTime @default(now())
  changedBy        String?
  auditLogId       String?  @unique
  requirement      Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditLog         AuditLog?   @relation(fields: [auditLogId], references: [id], onDelete: SetNull)

  @@unique([requirementId, version])
  @@index([projectId])
  @@index([requirementId])
}

// --- Test Senaryolari (Acceptance / System / Sub-system Test) ---------------
model TestCase {
  id          String   @id @default(uuid())
  projectId   String
  text_id     String
  title       String
  description String   @default("")
  type        String   // 'Acceptance Test' | 'System Test' | 'Sub-system Test'
  field       String? // gereksinimden otomatik kopyalanir
  status      String   @default("In Review") // 'Approved' (Passed) | 'Rejected' (Failed) | 'In Review'
  // Modular oznitelikler (Priority, DAL Level, projeye ozel ek alanlar).
  attributes  Json     @default("{}")
  author      String?
  approvalStatus String @default("Pending") // 'Pending' | 'Approved'
  locked         Boolean @default(false)    // onaylandiginda kilitlenir
  // Sorumlu kullanici — bkz. Requirement.assigneeId (#97/A: User tabanli).
  assigneeId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?    @relation("TestCaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // Coklu atama — bkz. Requirement.assignees.
  assignees   TestCaseAssignee[]

  @@unique([projectId, text_id])
  @@index([projectId, type])
  @@index([projectId, assigneeId])
}

// --- Coklu sorumlu kullanici atamasi (Issue #114/#115) ---------------------
//  Bir gereksinime/teste BIRDEN FAZLA sorumlu atanabilir. Sira ONEMLIDIR:
//  atama sirasi `order` ile saklanir, UI atananlari bu sirayla gosterir
//  (bkz. ViewModal "Atanan Kisiler" bolumu).
//
//  Geriye donuk uyumluluk: Requirement/TestCase.assigneeId KORUNUR ve daima
//  bu listenin ILK elemanina esitlenir (eski istemciler ve raporlar tek
//  atamayi okumaya devam eder). Tek dogruluk kaynagi bu tablodur.
//
//  Issue #97/A: eskiden Personnel'a baglanan bu tablolar artik User'a baglidir
//  (tek kimlik dunyasi). Kullanici silinince YALNIZCA atama satiri silinir
//  (Cascade); kaydin kendisi silinmez — kayit projeye aittir, kisiye degil.
model RequirementAssignee {
  requirementId String
  userId        String
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([requirementId, userId])
  @@index([userId])
  @@index([requirementId, order])
}

model TestCaseAssignee {
  testCaseId String
  userId     String
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  testCase   TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([testCaseId, userId])
  @@index([userId])
  @@index([testCaseId, order])
}

// --- Dinamik oznitelik tanimlari (Priority / DAL Level / ozel alanlar) -----
//  Proje bazli, admin (PM) tarafindan yonetilebilen semaya gore Requirement
//  ve TestCase kayitlarinin `attributes` JSONB torbasindaki degerler
//  dogrulanir. `system=true` olanlar (Priority, DAL Level) uygulamanin
//  varsayilan/gomulu oznitelikleridir; silinemez ama duzenlenebilir.
model AttributeDefinition {
  id           String   @id @default(uuid())
  projectId    String
  entityType   String   // 'requirement' | 'testcase' | 'both'
  key          String   // makine-okur anahtar, orn. 'priority', 'risk_score'
  label        String   // UI'da gosterilen etiket
  dataType     String   @default("text") // 'text' | 'number' | 'boolean' | 'date' | 'select'
  options      Json?    // dataType='select' icin [{ "value": "...", "label": "..." }, ...]
  required     Boolean  @default(false)
  defaultValue String?
  order        Int      @default(0)
  system       Boolean  @default(false) // gomulu (Priority/DAL Level) ise true; silinemez
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, entityType, key])
  @@index([projectId])
}

// --- Izlenebilirlik baglari -------------------------------------------------
//  type = 'Satisfies' | 'Verifies' | 'Assigned To'
//    Satisfies : fromId = UST gereksinim, toId = ALT gereksinim
//                (User <- System, System <- Software/Hardware)
//    Verifies  : fromId = gereksinim,      toId = test senaryosu
//    Assigned To: fromId = gereksinim,     toId = glossary terimi
model TraceabilityLink {
  id        String   @id @default(uuid())
  projectId String
  fromId    String
  toId      String
  type      String
  // Issue #57: Kaynak (fromId) gereksinimde ICERIK degisikligi oldugunda bu
  // bag 'supheli' (suspect) isaretlenir — alt gereksinimler (Satisfies) ve
  // testler (Verifies) icin. approve izni olanlar temizleyebilir.
  isSuspect Boolean  @default(false)
  createdAt DateTime @default(now())
  createdBy String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, fromId, toId, type])
  @@index([projectId, type])
}

// --- Sozluk (Glossary) ------------------------------------------------------
model GlossaryTerm {
  id         String   @id @default(uuid())
  projectId  String
  text_id    String
  term       String
  definition String   @default("")
  author     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, text_id])
  @@index([projectId])
}

// --- Degisiklik Tarihcesi (Audit Log) ---------------------------------------
model AuditLog {
  id         String   @id @default(uuid())
  projectId  String
  action     String
  entityType String?
  entityId   String?
  textId     String?
  field      String?
  oldValue   String?
  newValue   String?
  message    String?
  // Silme (ve ileride baska "geri alinamaz" islemler) icin ZORUNLU gerekce
  // metni — izlenebilirlik: "neden silindi" DB degisikligiyle BIRLIKTE
  // saklanir. Yalnizca DELETE/UNLINK/*_DELETE turu action'larda doldurulur;
  // digerlerinde (CREATE/UPDATE) null kalir. Sunucu tarafinda zorunlu
  // kilinir (bkz. server.js requireReason).
  reason     String?
  actor      String?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  historyEntry RequirementHistory? // Issue #57: versiyon satirinin bagli oldugu audit kaydi

  @@index([projectId])
}
