# backend yerel (Docker disi) calistirma icin ornek.
# Kullanim: cp .env.example .env   (sonra degerleri kendine gore doldur)
# Docker'da bu degerler docker-compose.yml icindeki 'environment' bloklarindan gelir.

# Not: <SIFRE> yerine kok .env'deki POSTGRES_PASSWORD ile ayni degeri yaz.
DATABASE_URL="postgresql://ehsim:<SIFRE>@localhost:5433/ehsim_rmt?schema=public"

# Tanimsizsa server.js acilmaz: "JWT_SECRET is required"
JWT_SECRET=degistir-beni-uzun-rastgele-anahtar

PORT=4001

# Backend CORS origin — boşsa varsayilan http://localhost:5173 (gelistirme).
# Production'da frontend domain'ini buraya yaz.
CORS_ORIGIN=
