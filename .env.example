# ============================================================================
#  .env.example — docker-compose.yml'in okudugu ortam degiskenleri sablonu.
#  Kullanim:  cp .env.example .env   (sonra degerleri kendine gore doldur)
#  Bu dosya ve .env Git'e GIRMEZ; gizli degerler repoya asla yazilmaz.
# ============================================================================

# PostgreSQL sifresi — uzun, rastgele bir deger sec.
# compose bunu hem db servisine hem backend DATABASE_URL'ine enjekte eder.
POSTGRES_PASSWORD=degistir-beni-uzun-rastgele-sifre

# JWT imzalama anahtari — tanimsizsa backend acilmaz ("JWT_SECRET is required").
# Uretmek icin: openssl rand -base64 48
JWT_SECRET=degistir-beni-uzun-rastgele-anahtar

# Bos = /api/auth/register KAPALI (onerilen). Yeni PM hesabi icin gizli bir
# deger gir ve istekte 'x-registration-key' basligiyla ayni degeri gonder.
PM_REGISTRATION_KEY=

# Backend CORS origin — boşsa varsayilan http://localhost:5173 (gelistirme).
# Production'da frontend domain'ini buraya yaz (orn. https://ehsim.example.com).
CORS_ORIGIN=
